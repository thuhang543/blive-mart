<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>BLive Mart - Siêu Thị Của Mọi Nhà</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link rel="stylesheet" href="styles.css" />
</head>
<body>

<!-- ============ TOP BAR ============ -->
<div class="topbar">
  <div class="container topbar-inner">
    <div class="topbar-left">
      <span><i class="fa-solid fa-truck-fast"></i> Miễn phí giao hàng toàn quốc</span>
      <span><i class="fa-solid fa-shield-halved"></i> Cam kết hàng chính hãng</span>
    </div>
    <div class="topbar-right">
      <span><i class="fa-solid fa-phone"></i> Hotline: 0918.475.394</span>
    </div>
  </div>
</div>

<!-- ============ HEADER ============ -->
<header class="site-header">
  <div class="container header-inner">
    <a href="#" class="logo">
      <div class="logo-mark">B<span>Live</span>Mart</div>
      <div class="logo-tag">Siêu Thị Của Mọi Nhà</div>
    </a>
    <nav class="nav">
      <a href="#home" class="active">Trang chủ</a>
      <a href="#about">Giới thiệu</a>
      <a href="#products">Sản phẩm</a>
      <a href="#affiliate">Ưu đãi</a>
      <a href="#news">Hướng dẫn</a>
      <a href="#contact">Liên hệ</a>
    </nav>
    <div class="header-actions">
      <button class="btn-icon" aria-label="Search"><i class="fa-solid fa-magnifying-glass"></i></button>
      <a href="#register" class="btn btn-primary btn-pill">
        <i class="fa-solid fa-user"></i> Tài app
      </a>
    </div>
  </div>
</header>

<!-- ============ HERO ============ -->
<section id="home" class="hero">
  <div class="hero-bg">
    <div class="blob b1"></div>
    <div class="blob b2"></div>
    <div class="blob b3"></div>
  </div>
  <div class="container hero-inner">
    <div class="hero-left">
      <p class="eyebrow">CHƯƠNG TRÌNH DÀNH CHO KHÁCH HÀNG MỚI</p>
      <h1 class="hero-title">
        Đăng ký App<br />
        <span class="brand-inline">BLive Mart</span> -<br />
        Nhận ngay <span class="highlight">500.000<sup>đ</sup></span> tiêu dùng
      </h1>
      <p class="hero-sub">Mua sắm sản phẩm công nghệ sinh học <br/>giá giảm đến <b>50%</b></p>
      <div class="hero-ctas">
        <a href="#register" class="btn btn-primary btn-lg">
          <i class="fa-regular fa-pen-to-square"></i> Đăng ký
        </a>
        <a href="#download" class="btn btn-ghost btn-lg">
          <i class="fa-solid fa-download"></i> Tải App
        </a>
      </div>
    </div>

    <div class="hero-right">
      <div class="hero-card">
        <div class="badge-500k">
          <div class="badge-inner">
            <span class="small">NHẬN NGAY</span>
            <span class="big">500.000<sup>đ</sup></span>
            <span class="small">TIÊU DÙNG</span>
          </div>
        </div>
        <div class="badge-50">
          <div>GIẢM</div>
          <div class="p">50%</div>
        </div>
        <div class="products-stage">
          <img src="https://images.unsplash.com/photo-1585421514738-01798e348b17?w=800&auto=format&fit=crop" alt="Products" />
        </div>

        <div class="mini-form">
          <p class="mini-title">Đăng ký nhận ưu đãi 500.000<sup>đ</sup></p>
          <input type="text" placeholder="Họ và tên" />
          <input type="tel" placeholder="Số điện thoại" />
          <button class="btn btn-primary btn-block">Đăng ký ngay</button>
        </div>
      </div>
    </div>
  </div>

  <!-- KPI strip -->
  <div class="container">
    <div class="kpi-strip">
      <div class="kpi"><div class="kpi-num">500.000+</div><div class="kpi-label">Khách hàng tin dùng</div></div>
      <div class="kpi"><div class="kpi-num">100%</div><div class="kpi-label">Hàng chính hãng</div></div>
      <div class="kpi"><div class="kpi-num">50%</div><div class="kpi-label">Giá tận gốc nhà máy</div></div>
      <div class="kpi"><div class="kpi-num">24/7</div><div class="kpi-label">Giao hàng tận nơi</div></div>
      <div class="kpi"><div class="kpi-num logos"><img src="https://upload.wikimedia.org/wikipedia/commons/thumb/8/89/FDA_logo.svg/200px-FDA_logo.svg.png" alt="FDA"/></div><div class="kpi-label">Chứng nhận FDA</div></div>
    </div>
  </div>
</section>

<!-- ============ SECTION 2 : TV / PRESS ============ -->
<section class="section press-section" id="about">
  <div class="container">
    <div class="section-head">
      <span class="section-num">01</span>
      <h2 class="section-title">TRUYỀN HÌNH VÀ BÁO CHÍ <br/> NÓI VỀ <span class="highlight">BLIVE MART</span></h2>
    </div>

    <div class="press-grid">
      <div class="press-left">
        <div class="press-brand">
          <div class="logo-mark small">B<span>Live</span>Mart</div>
          <p class="press-desc">BLive Mart là thương hiệu Việt được các cơ quan truyền thông uy tín và Nhà nước tin tưởng lựa chọn.</p>
        </div>
      </div>

      <article class="press-card">
        <div class="press-thumb"><img src="https://images.unsplash.com/photo-1495020689067-958852a7765e?w=600&auto=format&fit=crop" alt=""/></div>
        <div class="press-badge">VTV</div>
        <h3>BLive Mart siêu thị Việt và câu chuyện gia thay đổi</h3>
        <a href="#" class="press-more">Đọc thêm <i class="fa-solid fa-arrow-right"></i></a>
      </article>

      <article class="press-card">
        <div class="press-thumb"><img src="https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=600&auto=format&fit=crop" alt=""/></div>
        <div class="press-badge">DÂNTRÍ</div>
        <h3>BLive Mart - Nơi khởi nguồn cho hàng Việt chất lượng cao</h3>
        <a href="#" class="press-more">Đọc thêm <i class="fa-solid fa-arrow-right"></i></a>
      </article>

      <article class="press-card">
        <div class="press-thumb"><img src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?w=600&auto=format&fit=crop" alt=""/></div>
        <div class="press-badge">VNEXPRESS</div>
        <h3>Người tiêu dùng Việt tin chọn BLive Mart hạng đầu</h3>
        <a href="#" class="press-more">Đọc thêm <i class="fa-solid fa-arrow-right"></i></a>
      </article>
    </div>

    <!-- Bottom benefits -->
    <div class="benefits">
      <div class="benefit">
        <div class="b-num">01</div>
        <div>
          <h4>HÀNG NGHÌN</h4>
          <p>Khách hàng tin dùng và ủng hộ BLive Mart</p>
        </div>
      </div>
      <div class="benefit">
        <div class="b-num">02</div>
        <div>
          <h4>GIẢM GIÁ ĐẾN 50%</h4>
          <p>Cho tất cả các sản phẩm chính hãng</p>
        </div>
      </div>
      <div class="benefit">
        <div class="b-num">03</div>
        <div>
          <h4>ƯU ĐÃI NGAY 500.000Đ</h4>
          <p>Cho khách hàng đăng ký App mới</p>
        </div>
      </div>
      <div class="benefit">
        <div class="b-num">04</div>
        <div>
          <h4>CAM KẾT 100%</h4>
          <p>Hàng chính hãng, giá tận gốc nhà máy</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ SECTION 3 : BENEFITS OF JOIN ============ -->
<section class="section benefits-section">
  <div class="container">
    <div class="section-head center">
      <span class="section-num">02</span>
      <h2 class="section-title">LỢI ÍCH KHI THAM GIA <span class="highlight">BLIVE MART</span></h2>
      <p class="section-desc"><b>MUA SẮM THÔNG MINH - NHẬN ƯU ĐÃI THẬT</b></p>
      <p class="section-desc small">BLive Mart mang đến cho bạn hệ thống mua sắm sản phẩm công nghệ sinh học chất lượng cao <br/>giá tốt nhất, cùng nhiều quyền lợi hấp dẫn</p>
    </div>

    <div class="benefits-grid">
      <div class="bcard">
        <div class="bcard-badge">01</div>
        <div class="bcard-icon"><i class="fa-solid fa-crown"></i></div>
        <h3>VIP</h3>
        <p>Đăng ký miễn phí trở thành khách hàng VIP để nhận nhiều ưu đãi hơn khi mua sắm</p>
      </div>
      <div class="bcard">
        <div class="bcard-badge">02</div>
        <div class="bcard-icon"><i class="fa-solid fa-gift"></i></div>
        <h3>Tặng 500.000đ tiêu dùng</h3>
        <p>Nhận ngay 500.000đ áp dụng ngay cho lần mua sắm đầu tiên</p>
      </div>
      <div class="bcard">
        <div class="bcard-badge">03</div>
        <div class="bcard-icon"><i class="fa-solid fa-tags"></i></div>
        <h3>Giảm giá đến 50%</h3>
        <p>Mua hàng công nghệ sinh học giá giảm đến 50% so với thị trường</p>
      </div>
      <div class="bcard">
        <div class="bcard-badge">04</div>
        <div class="bcard-icon"><i class="fa-solid fa-boxes-stacked"></i></div>
        <h3>Sản phẩm chính hãng</h3>
        <p>Cam kết 100% sản phẩm chính hãng từ nhà máy BLive Đức - Nhật Bản</p>
      </div>
      <div class="bcard">
        <div class="bcard-badge">05</div>
        <div class="bcard-icon"><i class="fa-solid fa-truck"></i></div>
        <h3>Giao hàng tận nơi</h3>
        <p>Giao hàng nhanh chóng, miễn phí toàn quốc cho đơn hàng đủ điều kiện</p>
      </div>
      <div class="bcard">
        <div class="bcard-badge">06</div>
        <div class="bcard-icon"><i class="fa-solid fa-headset"></i></div>
        <h3>Chia sẻ tính -  khách từ app dễ dàng</h3>
        <p>Đội ngũ chăm sóc khách hàng chuyên nghiệp, hỗ trợ 24/7</p>
      </div>
    </div>

    <div class="press-strip">
      <p>BLive Mart được báo chí và truyền hình đưa tin</p>
      <div class="press-logos">
        <span>VTV</span><span>VTC</span><span>HTV</span><span>DÂN TRÍ</span><span>NLĐ</span><span>TUỔI TRẺ</span><span>KENH14</span>
      </div>
    </div>

    <a href="#register" class="mega-cta">
      <i class="fa-regular fa-hand-pointer"></i> ĐĂNG KÝ NHẬN ƯU ĐÃI NGAY
    </a>
  </div>
</section>

<!-- ============ SECTION 4 : PRODUCTS ============ -->
<section class="section products-section" id="products">
  <div class="container">
    <div class="section-head center">
      <span class="section-num">03</span>
      <h2 class="section-title">SẢN PHẨM <span class="highlight">ƯU ĐÃI</span> NỔI BẬT</h2>
      <p class="section-desc small">Giá tốt mỗi ngày - Tiết kiệm cho mọi nhà</p>
    </div>

    <div class="product-tabs">
      <button class="tab active">Tất cả sản phẩm</button>
      <button class="tab">Giặt xả</button>
      <button class="tab">Chăm sóc da</button>
      <button class="tab">Chăm sóc răng</button>
      <button class="tab">Khuyến mãi</button>
    </div>

    <div class="product-grid">
      <article class="product">
        <div class="p-tag">-50%</div>
        <div class="p-img"><img src="https://images.unsplash.com/photo-1610557892470-55d9e80c0bce?w=400&auto=format&fit=crop" alt=""/></div>
        <h4>Túi giặt xả D-bé 3.5kg</h4>
        <div class="p-price"><span class="now">64.000đ</span><span class="was">128.000đ</span></div>
        <button class="btn btn-mini">Mua ngay</button>
      </article>
      <article class="product">
        <div class="p-tag">-50%</div>
        <div class="p-img"><img src="https://images.unsplash.com/photo-1585386959984-a4155224a1ad?w=400&auto=format&fit=crop" alt=""/></div>
        <h4>Can giặt xả D-bé 10kg</h4>
        <div class="p-price"><span class="now">178.000đ</span><span class="was">356.000đ</span></div>
        <button class="btn btn-mini">Mua ngay</button>
      </article>
      <article class="product">
        <div class="p-tag">-50%</div>
        <div class="p-img"><img src="https://images.unsplash.com/photo-1556228453-efd6c1ff04f6?w=400&auto=format&fit=crop" alt=""/></div>
        <h4>Nước rửa BLive 750g</h4>
        <div class="p-price"><span class="now">20.000đ</span><span class="was">40.000đ</span></div>
        <button class="btn btn-mini">Mua ngay</button>
      </article>
      <article class="product">
        <div class="p-tag">-50%</div>
        <div class="p-img"><img src="https://images.unsplash.com/photo-1583947215259-38e31be8751f?w=400&auto=format&fit=crop" alt=""/></div>
        <h4>Túi lau sàn BLive 3.5kg</h4>
        <div class="p-price"><span class="now">36.500đ</span><span class="was">73.000đ</span></div>
        <button class="btn btn-mini">Mua ngay</button>
      </article>
      <article class="product">
        <div class="p-tag">-50%</div>
        <div class="p-img"><img src="https://images.unsplash.com/photo-1584306670957-acf935f5033c?w=400&auto=format&fit=crop" alt=""/></div>
        <h4>Xả vải khô BLive 1000ml</h4>
        <div class="p-price"><span class="now">26.000đ</span><span class="was">52.000đ</span></div>
        <button class="btn btn-mini">Mua ngay</button>
      </article>
      <article class="product">
        <div class="p-tag">-50%</div>
        <div class="p-img"><img src="https://images.unsplash.com/photo-1631730359585-38a4935cbec4?w=400&auto=format&fit=crop" alt=""/></div>
        <h4>Sữa tắm BLive 800g</h4>
        <div class="p-price"><span class="now">72.500đ</span><span class="was">145.000đ</span></div>
        <button class="btn btn-mini">Mua ngay</button>
      </article>
      <article class="product">
        <div class="p-tag">-50%</div>
        <div class="p-img"><img src="https://images.unsplash.com/photo-1570194065650-d99fb4bedf0a?w=400&auto=format&fit=crop" alt=""/></div>
        <h4>Tinh chất chăm sóc BLive 500g</h4>
        <div class="p-price"><span class="now">70.500đ</span><span class="was">141.000đ</span></div>
        <button class="btn btn-mini">Mua ngay</button>
      </article>
      <article class="product">
        <div class="p-tag">-50%</div>
        <div class="p-img"><img src="https://images.unsplash.com/photo-1608571423902-eed4a5ad8108?w=400&auto=format&fit=crop" alt=""/></div>
        <h4>Dầu gội hương hoa BLive 500g</h4>
        <div class="p-price"><span class="now">72.000đ</span><span class="was">144.000đ</span></div>
        <button class="btn btn-mini">Mua ngay</button>
      </article>
    </div>

    <div class="center-btn">
      <a href="#" class="btn btn-outline btn-pill">Xem tất cả sản phẩm <i class="fa-solid fa-arrow-right"></i></a>
    </div>
  </div>
</section>

<!-- ============ SECTION 5 : 3 STEPS ============ -->
<section class="section steps-section" id="affiliate">
  <div class="container">
    <div class="section-head center">
      <span class="section-num">04</span>
      <h2 class="section-title">3 BƯỚC ĐƠN GIẢN <br/> TRẢI NGHIỆM <span class="highlight">BLIVE MART</span></h2>
      <p class="section-desc small">Tham gia ngay để mua hàng công nghệ sinh học giá tận gốc nhà máy <br/> và nhận nhiều ưu đãi hấp dẫn</p>
    </div>

    <div class="steps-grid">
      <div class="step-card">
        <div class="step-num">1</div>
        <h3>BƯỚC 1</h3>
        <p>Đăng ký tài khoản BLive Mart để trở thành khách hàng VIP của BLive Mart hoàn toàn miễn phí</p>
        <a href="#register" class="btn btn-primary btn-pill btn-sm">ĐĂNG KÝ</a>
      </div>
      <div class="step-card">
        <div class="step-num">2</div>
        <h3>BƯỚC 2</h3>
        <p>Tải App BLive Mart trên App Store hoặc CH Play</p>
        <div class="store-btns">
          <a href="#" class="store"><i class="fa-brands fa-apple"></i> App Store</a>
          <a href="#" class="store"><i class="fa-brands fa-google-play"></i> Google Play</a>
        </div>
      </div>
      <div class="step-card">
        <div class="step-num">3</div>
        <h3>BƯỚC 3</h3>
        <p>Đăng nhập tài khoản BLive Mart của bạn vừa đăng ký và bắt đầu trải nghiệm ưu đãi. Nhận ngay 500.000đ tiêu dùng và giảm giá đến 50% mọi mặt hàng.</p>
        <div class="phone-mock">
          <img src="https://images.unsplash.com/photo-1512941937669-90a1b58e7e9c?w=300&auto=format&fit=crop" alt=""/>
        </div>
      </div>
    </div>

    <div class="promise-bar">
      <div class="promise"><i class="fa-solid fa-award"></i> Sản phẩm chính hãng</div>
      <div class="promise"><i class="fa-solid fa-tag"></i> Giá tận gốc nhà máy</div>
      <div class="promise"><i class="fa-solid fa-crown"></i> Ưu đãi VIP công nghệ sinh học</div>
      <div class="promise"><i class="fa-solid fa-headset"></i> Hỗ trợ tận nơi 24/7</div>
    </div>
  </div>
</section>

<!-- ============ REGISTER ============ -->
<section class="section register-section" id="register">
  <div class="container">
    <div class="register-wrap">
      <div class="reg-left">
        <h2 class="section-title">ĐĂNG KÝ NHẬN ƯU ĐÃI <br/> TỪ <span class="highlight">BLIVE MART</span></h2>
        <p>Điền thông tin để nhận ngay ưu đãi <b>500.000đ</b> tiêu dùng và các chương trình khuyến mãi hấp dẫn</p>
        <ul class="reg-list">
          <li><i class="fa-solid fa-check"></i> Nhận 500.000đ tiêu dùng</li>
          <li><i class="fa-solid fa-check"></i> Giảm giá đến 50%</li>
          <li><i class="fa-solid fa-check"></i> Miễn phí giao hàng</li>
        </ul>
      </div>
      <form class="reg-form" onsubmit="event.preventDefault(); alert('Cảm ơn bạn đã đăng ký!');">
        <div class="form-field"><i class="fa-solid fa-user"></i><input type="text" placeholder="Họ và tên" required/></div>
        <div class="form-field"><i class="fa-solid fa-phone"></i><input type="tel" placeholder="Số điện thoại" required/></div>
        <div class="form-field"><i class="fa-solid fa-envelope"></i><input type="email" placeholder="Email"/></div>
        <div class="form-field"><i class="fa-solid fa-location-dot"></i>
          <select>
            <option>Tỉnh / Thành phố</option>
            <option>Hà Nội</option><option>TP. Hồ Chí Minh</option><option>Đà Nẵng</option>
          </select>
        </div>
        <button class="btn btn-gold btn-block btn-lg">ĐĂNG KÝ NGAY</button>
        <p class="reg-note"><i class="fa-solid fa-lock"></i> Thông tin của bạn được bảo mật tuyệt đối</p>
      </form>
    </div>
  </div>
</section>

<!-- ============ FOOTER ============ -->
<footer class="footer">
  <div class="container footer-grid">
    <div>
      <div class="logo-mark">B<span>Live</span>Mart</div>
      <p class="foot-desc">BLive Mart - Siêu thị của mọi nhà. Nơi mua sắm hàng công nghệ sinh học chất lượng cao giá tận gốc nhà máy.</p>
      <div class="socials">
        <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
        <a href="#"><i class="fa-brands fa-youtube"></i></a>
        <a href="#"><i class="fa-brands fa-tiktok"></i></a>
        <a href="#"><i class="fa-brands fa-instagram"></i></a>
      </div>
    </div>
    <div>
      <h4>Về BLive Mart</h4>
      <ul><li><a href="#">Giới thiệu</a></li><li><a href="#">Sản phẩm</a></li><li><a href="#">Tin tức</a></li><li><a href="#">Tuyển dụng</a></li></ul>
    </div>
